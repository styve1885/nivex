# — NIVEX · variables d'environnement —
# Origine publique du site (doit correspondre à l'URI de redirection Google)
NEXT_PUBLIC_SITE_URL=https://nivex-repassage.vercel.app

# Identifiants OAuth (Google Cloud Console → API et services → Identifiants)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# — Temps de trajet en transport en commun —
#
# Votre adresse de départ. Elle ne quitte jamais le serveur : elle n'est ni
# affichée sur le site, ni envoyée au navigateur, ni écrite en base. Écrivez-la
# comme vous la diriez à un chauffeur, avec la ville et la province.
NIVEX_HOME_ADDRESS=

# Clé de l'API Google Routes (Google Cloud Console → API et services).
# Distincte des identifiants OAuth ci-dessus. Voir docs/trajet.md.
GOOGLE_MAPS_API_KEY=

# Postgres (injecté automatiquement par l'intégration Neon de Vercel)
DATABASE_URL=

# 32 octets — chiffre le jeton Google. openssl rand -hex 32
ENCRYPTION_KEY=

# Signe les cookies de session. openssl rand -base64 48
SESSION_SECRET=

# Optionnel : code exigé à la toute première connexion de l'artisan.
# Sans lui, le premier compte Google qui se connecte devient le propriétaire.
ADMIN_SETUP_CODE=

# Développement uniquement : agenda fictif pour essayer le tunnel de
# réservation sans base de données ni compte Google. Ne jamais poser en
# production — le code refuse de l'activer si VERCEL_ENV vaut "production".
NIVEX_DEMO=1

# Développement uniquement : détourne l'API Routes vers un serveur d'essai,
# pour éprouver les quatre cas de trajet sans appeler Google. Même double
# verrou que NIVEX_DEMO — ignorée si VERCEL_ENV vaut "production".
# NIVEX_ROUTES_ENDPOINT=http://localhost:5055
