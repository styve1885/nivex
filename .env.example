# — NIVEX · variables d'environnement —
# Origine publique du site. En production, le code prend toujours
# https://www.nivexrepassage.ca (SITE_URL, src/lib/brand.ts), quoi que dise
# cette variable : elle ne compte que pour les versions d'essai et en local.
NEXT_PUBLIC_SITE_URL=https://www.nivexrepassage.ca

# Identifiants OAuth (Google Cloud Console → API et services → Identifiants).
# URI de retour déclarée chez Google :
# https://www.nivexrepassage.ca/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres (injecté automatiquement par l'intégration Neon de Vercel)
DATABASE_URL=

# 32 octets — chiffre le jeton Google. openssl rand -hex 32
ENCRYPTION_KEY=

# Signe les cookies de session. openssl rand -base64 48
SESSION_SECRET=

# Ouvre la tâche quotidienne (/api/cron/daily) : rappels de la veille aux
# abonnés et courriel de fin de série. Vercel l'envoie seul chaque matin
# dans l'en-tête Authorization. Sans elle, la tâche refuse de tourner.
# openssl rand -hex 32
CRON_SECRET=

# Textos (Twilio). Sans ces trois clés, seuls les courriels partent.
# TWILIO_FROM est le numéro acheté chez Twilio, au format +1XXXXXXXXXX.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Le cellulaire de l'artisan, où arrivent ses avis, les réponses des clients
# et les appels. Jamais le numéro de la maison (celui de Twilio) : sans cette
# variable, rien de tout cela ne lui parvient.
SMS_OWNER_TO=
# Facultatif : le service de messagerie Twilio (MG…) qui programme le texto
# « je serai chez vous » de deux heures avant. Sans lui, ce texto ne part pas.
TWILIO_MESSAGING_SERVICE_SID=

# Optionnel : code exigé à la toute première connexion de l'artisan.
# Sans lui, le premier compte Google qui se connecte devient le propriétaire.
ADMIN_SETUP_CODE=

# Développement uniquement : agenda fictif pour essayer le tunnel de
# réservation sans base de données ni compte Google. Ne jamais poser en
# production — le code refuse de l'activer si VERCEL_ENV vaut "production".
NIVEX_DEMO=1
